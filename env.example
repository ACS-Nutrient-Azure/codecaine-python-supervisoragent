# Supervisor Agent 환경변수
# AgentCore Runtime 배포용

# ── AWS 기본 설정 (필수) ─────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ── 다른 Agent/Backend 연결 (필수) ───────────────────────────────────────────
# Analysis Backend (VPC 내부 Service Discovery DNS)
ANALYSIS_BACKEND_URL=http://cdci-prd-analysis-service.cdci-prd.internal:8000

# Question Agent Runtime ARN
QUESTION_AGENT_ARN=arn:aws:bedrock-agentcore:ap-northeast-2:xxxxx:agent-runtime/xxxxx

# Summary Agent Runtime ARN
SUMMARY_AGENT_ARN=arn:aws:bedrock-agentcore:ap-northeast-2:xxxxx:agent-runtime/xxxxx

# ── AgentCore Memory (선택) ──────────────────────────────────────────────────
# 채팅 세션 단기 기억 사용 여부 (사용 시 true로 변경)
USE_MEMORY=false
# Memory ID (USE_MEMORY=true인 경우 필수)
MEMORY_ID=

# ── 로컬 테스트용 (배포 시 불필요) ───────────────────────────────────────────
USE_LOCAL_TEST=false
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini
